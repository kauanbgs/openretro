@@ -1456,6 +1464,8 @@ static void rcheevos_client_load_game_callback(int result,
       size_t _len;
       if (result == RC_NO_GAME_LOADED)
       {
+         /* OpenRetro remembers that this file has no achievement set. */
+         RARCH_LOG("[OpenRetro] Achievements game: 0\n");
          CHEEVOS_LOG(RCHEEVOS_TAG "Game not recognized, pausing hardcore\n");
          rcheevos_pause_hardcore();
 
@@ -1516,6 +1526,10 @@ static void rcheevos_client_load_game_callback(int result,
       rc_client_set_read_memory_function(client, rcheevos_client_read_memory);
    }
 
