+++ b/cheevos/cheevos.c
@@ -294,6 +294,11 @@ static void rcheevos_award_achievement(const rc_client_achievement_t* cheevo)
    if (!cheevo)
       return;
 
+   /* OpenRetro reads this line from the session log to report the unlock. */
+   RARCH_LOG("[OpenRetro] Achievement unlocked: %u %u %d\n",
+         (unsigned)cheevo->id, (unsigned)cheevo->points,
+         rc_client_get_hardcore_enabled(rcheevos_locals.client) ? 1 : 0);
+
    /* Show the on screen message. */
    if (settings->bools.cheevos_visibility_unlock)
    {
@@ -1351,6 +1356,9 @@ static void rcheevos_client_login_callback(int result,
       _len += strlcpy(msg + _len, error_message, sizeof(msg) - _len);
