diff --git a/input/openretro_party_input.h b/input/openretro_party_input.h
new file mode 100644
--- /dev/null
+++ b/input/openretro_party_input.h
@@ -0,0 +1,24 @@
+/* Party seats never inherit local input, including when remote is neutral. */
+#ifndef OPENRETRO_PARTY_INPUT_H
+#define OPENRETRO_PARTY_INPUT_H
+#include <stdint.h>
+#include <libretro.h>
+static int16_t openretro_party_input(unsigned device, unsigned idx, unsigned id,
+      uint64_t buttons, const int16_t analog[4])
+{
+   if (device == RETRO_DEVICE_JOYPAD)
+   {
+      if (id == RETRO_DEVICE_ID_JOYPAD_MASK)
+         return (int16_t)(buttons & UINT64_C(0xffff));
+      return id < 16 ? (int16_t)((buttons >> id) & 1) : 0;
+   }
+   if (device == RETRO_DEVICE_ANALOG)
+   {
+      if (idx < 2 && id < 2)
+         return analog[idx * 2 + id];
+      if (idx == RETRO_DEVICE_INDEX_ANALOG_BUTTON && id < 16)
+         return (buttons & (UINT64_C(1) << id)) ? 32767 : 0;
+   }
+   return 0;
+}
+#endif
