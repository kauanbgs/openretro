+#ifdef _WIN32
+/* OpenRetro: publish frames in shared memory named after this process, so
+ * OpenRetro can stream them to a phone. The sequence number is odd while a
+ * frame is written. OpenRetro stamps `wanted` with GetTickCount() while a
+ * phone watches; GPU frames are read back only then. */
+#define OPENRETRO_FRAME_MAGIC 0x3246524fu /* "ORF2" */
+#define OPENRETRO_FRAME_BYTES (16u * 1024u * 1024u)
+struct openretro_frame_header
+{
+   uint32_t magic;
+   volatile LONG sequence;
+   uint32_t width;
+   uint32_t height;
+   uint32_t pitch;
+   uint32_t format;
+   volatile LONG wanted;
+   uint32_t reserved;
+};
+
+static struct openretro_frame_header *openretro_frames(void)
+{
+   static struct openretro_frame_header *shared = NULL;
+   static bool unavailable                      = false;
+   if (!shared && !unavailable)
+   {
+      char name[64];
+      HANDLE mapping;
+      snprintf(name, sizeof(name), "Local\\OpenRetroFrames-%lu",
+            (unsigned long)GetCurrentProcessId());
+      mapping = CreateFileMappingA(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE,
+            0, sizeof(*shared) + OPENRETRO_FRAME_BYTES, name);
+      if (mapping)
+         shared = (struct openretro_frame_header*)MapViewOfFile(mapping,
+               FILE_MAP_ALL_ACCESS, 0, 0, 0);
+      if (shared)
+         shared->magic = OPENRETRO_FRAME_MAGIC;
+      else
+         unavailable = true;
+   }
+   return shared;
+}
+
+bool openretro_frame_wanted(void)
+{
+   struct openretro_frame_header *shared = openretro_frames();
+   return shared && (DWORD)(GetTickCount() - (DWORD)shared->wanted) < 2000;
+}
+
+/* `format` is a retro_pixel_format, or OPENRETRO_FORMAT_BGRA_FLIPPED (100)
+ * for a GPU readback stored bottom row first. */
+void openretro_publish_frame(const void *data, unsigned width,
+      unsigned height, size_t pitch, unsigned format)
+{
+   struct openretro_frame_header *shared = openretro_frames();
+   size_t size                           = pitch * height;
+   if (!shared || !data || size > OPENRETRO_FRAME_BYTES)
+      return;
+   InterlockedIncrement(&shared->sequence);
+   shared->width  = width;
+   shared->height = height;
+   shared->pitch  = (uint32_t)pitch;
+   shared->format = format;
+   memcpy(shared + 1, data, size);
+   InterlockedIncrement(&shared->sequence);
+}
+
+static void openretro_share_frame(const void *data, unsigned width,
+      unsigned height, size_t pitch, enum retro_pixel_format format)
+{
+   if (data && data != RETRO_HW_FRAME_BUFFER_VALID)
+      openretro_publish_frame(data, width, height, pitch, (unsigned)format);
+}
+#endif
+
 void video_driver_frame(const void *data, unsigned width,
       unsigned height, size_t pitch)
 {
@@ -3771,6 +3848,10 @@ void video_driver_frame(const void *data, unsigned width,
    if (!video_driver_active)
       return;
 
+#ifdef _WIN32
+   openretro_share_frame(data, width, height, pitch, video_driver_pix_fmt);
+#endif
+
    new_time                      = cpu_features_get_time_usec();
    runloop_st->core_run_time     = new_time - runloop_st->core_run_time;
 
