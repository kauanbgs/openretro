diff --git a/gfx/drivers/gl2.c b/gfx/drivers/gl2.c
index 977110c..e3383df 100644
--- a/gfx/drivers/gl2.c
+++ b/gfx/drivers/gl2.c
@@ -3371,6 +3371,61 @@ static void gl2_pbo_async_readback(gl2_t *gl)
    gl2_renderchain_unbind_pbo();
 }
 
+#if defined(_WIN32) && !defined(HAVE_OPENGLES)
+bool openretro_frame_wanted(void);
+void openretro_publish_frame(const void *data, unsigned width,
+      unsigned height, size_t pitch, unsigned format);
+
+/* OpenRetro: cores that draw on the GPU hand the CPU no frame, so while a
+ * phone watches, read the finished picture back through two pixel buffers.
+ * Each frame starts one copy and publishes the previous one, so the GPU
+ * never stalls. Buffers follow the viewport when the window is resized. */
+static void openretro_gpu_readback(gl2_t *gl)
+{
+   static GLuint pbo[2];
+   static unsigned width[2], height[2];
+   static bool ready[2];
+   static unsigned index;
+   unsigned previous = index ^ 1;
+   unsigned w        = gl->vp.width;
+   unsigned h        = gl->vp.height;
+
+   if (!(gl->flags & GL2_FLAG_HW_RENDER_USE) || !openretro_frame_wanted()
+         || !w || !h)
+   {
+      ready[0] = ready[1] = false;
+      return;
+   }
+   if (!pbo[0])
+      glGenBuffers(2, pbo);
+
+   glBindBuffer(GL_PIXEL_PACK_BUFFER, pbo[index]);
+   if (width[index] != w || height[index] != h)
+      glBufferData(GL_PIXEL_PACK_BUFFER, (GLsizeiptr)w * h * 4, NULL,
+            GL_STREAM_READ);
+   glPixelStorei(GL_PACK_ALIGNMENT, 4);
+   glReadPixels(gl->vp.x, gl->vp.y, w, h, GL_BGRA,
+         GL_UNSIGNED_INT_8_8_8_8_REV, NULL);
+   width[index]  = w;
+   height[index] = h;
+   ready[index]  = true;
+
+   if (ready[previous])
+   {
+      const void *pixels;
+      glBindBuffer(GL_PIXEL_PACK_BUFFER, pbo[previous]);
+      if ((pixels = glMapBuffer(GL_PIXEL_PACK_BUFFER, GL_READ_ONLY)))
+      {
+         openretro_publish_frame(pixels, width[previous], height[previous],
+               width[previous] * 4, 100);
+         glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+      }
+   }
+   glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+   index = previous;
+}
+#endif
+
 static bool gl2_frame(void *data, const void *frame,
       unsigned frame_width, unsigned frame_height,
       uint64_t frame_count,
@@ -3660,6 +3715,10 @@ static bool gl2_frame(void *data, const void *frame,
 #endif
             gl2_pbo_async_readback(gl);
 
+#if defined(_WIN32) && !defined(HAVE_OPENGLES)
+   openretro_gpu_readback(gl);
+#endif
+
     if (gl->ctx_driver->swap_buffers)
         gl->ctx_driver->swap_buffers(gl->ctx_data);
 
