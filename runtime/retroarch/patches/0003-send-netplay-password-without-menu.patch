diff --git a/network/netplay/netplay_frontend.c b/network/netplay/netplay_frontend.c
index 6e7042cb90..e0e31b0030 100644
--- a/network/netplay/netplay_frontend.c
+++ b/network/netplay/netplay_frontend.c
@@ -1135,6 +1135,31 @@ bool netplay_handshake_init(netplay_t *netplay,
 
       if (!netplay_handshake_nick(netplay, connection))
          return false;
+#ifndef HAVE_MENU
+      /* Without a menu to ask, answer with the configured password. The
+       * server reads it after the nick. */
+      if (connection->salt)
+      {
+         size_t _len;
+         struct password_buf_s password_buf;
+         char password[8+NETPLAY_PASS_LEN];
+         char hash[NETPLAY_PASS_HASH_LEN+1];
+         settings_t *settings = config_get_ptr();
+
+         _len = snprintf(password, sizeof(password),
+               "%08lX", (unsigned long)connection->salt);
+         strlcpy(password + _len, settings->paths.netplay_password,
+               sizeof(password) - _len);
+         password_buf.cmd[0] = htonl(NETPLAY_CMD_PASSWORD);
+         password_buf.cmd[1] = htonl(sizeof(password_buf.password));
+         sha256_hash(hash, (uint8_t *) password, strlen(password));
+         memcpy(password_buf.password, hash, NETPLAY_PASS_HASH_LEN);
+         if (!netplay_send(&connection->send_packet_buffer, connection->fd,
+                  &password_buf, sizeof(password_buf)))
+            return false;
+         netplay_send_flush(&connection->send_packet_buffer, connection->fd, false);
+      }
+#endif
    }
 
    /* Move on to the next mode */
