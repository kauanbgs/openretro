{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRetro",
  "version": "0.3.3",
  "identifier": "org.openretro.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenRetro",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 680,
        "backgroundColor": "#111521"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost https://images.launchbox-app.com https://images.igdb.com https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/screenshots/**",
          "$APPCACHE/launchbox-thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Your classic games, at home.",
    "resources": {
      "resources/runtime/retroarch": "runtime/retroarch"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzQjQ2NThEODIxOTJERUIKUldUckxSbUNqV1cwZy9YWEIyQjFFY2R1dGVSZGVLYXVxYzdBZDdoVS9ZYmZkUmEvNGhoN0ZOTk8K",
      "endpoints": [
        "https://github.com/kauanbgs/openretro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
