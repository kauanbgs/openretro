HOST=127.0.0.1
PORT=8787
# Operator configuration only. The shipped app already knows this public origin.
PUBLIC_URL=https://party.example.com
# Run coturn on your own server with the same secret in turnserver.conf.
# Use a generated secret of at least 32 random bytes. Never ship it to the app.
TURN_SECRET=replace-with-a-long-random-secret
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Enable only behind a proxy that overwrites X-Party-Client-IP.
TRUST_PROXY=true
MAX_ROOMS=32
MAX_ROOMS_PER_IP=2
MAX_CREATES_PER_10_MIN=12
# Local development only. No external STUN service is contacted in this mode.
ALLOW_STUN_ONLY=false
