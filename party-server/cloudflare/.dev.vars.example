# Local tests only. Never set this variable in a published Worker.
ALLOW_LOCAL_TEST=true
# Production secrets are entered with wrangler secret put, never committed.
# TURN_KEY_ID=your-realtime-turn-key-id
# TURN_API_TOKEN=your-realtime-turn-api-token

# Local account development only; the Worker rejects this mode on public hosts.
SOCIAL_DEV_MODE=true
AUTH_PEPPER=local-development-placeholder-not-for-production
# Omit RESEND_API_KEY locally to print only the code in the local terminal.
# RESEND_API_KEY=replace-in-ignored-dev-vars-only
# EMAIL_FROM=OpenRetro <conta@seu-dominio.com.br>
