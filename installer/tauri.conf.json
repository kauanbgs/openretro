{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRetro Setup",
  "version": "1.0.0",
  "identifier": "org.openretro.installer",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenRetro Setup",
        "width": 720,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../src-tauri/icons/icon.ico"]
  }
}
