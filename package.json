{
  "name": "openretro",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:runtime-recipe": "pwsh -NoProfile -File scripts/test-runtime-recipe.ps1",
    "tauri": "powershell -ExecutionPolicy Bypass -File scripts/tauri.ps1",
    "build:runtime": "powershell -ExecutionPolicy Bypass -File scripts/build-openretro-runtime.ps1",
    "build:runtime:dev": "powershell -ExecutionPolicy Bypass -File scripts/build-openretro-runtime.ps1 -Incremental",
    "prepare:runtime": "powershell -ExecutionPolicy Bypass -File scripts/vendor-retroarch-runtime.ps1",
    "prepare:runtime:official": "powershell -ExecutionPolicy Bypass -File scripts/vendor-retroarch-runtime.ps1 -AllowOfficialFallback",
    "bundle:windows": "npm run prepare:runtime && tauri build",
    "format": "prettier --write src tests index.html vite.config.ts *.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests index.html vite.config.ts *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  }
}
